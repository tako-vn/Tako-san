{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "receipts"],
  "properties": {
    "version": { "const": 1 },
    "receipts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_easy", "receipt_medium", "receipt_hard", "receipt_veryhard"],
      "properties": {
        "receipt_easy": { "$ref": "#/$defs/receipt" },
        "receipt_medium": { "$ref": "#/$defs/receipt" },
        "receipt_hard": { "$ref": "#/$defs/receipt" },
        "receipt_veryhard": { "$ref": "#/$defs/receipt" }
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "quantity", "totalPriceVnd"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "quantity": { "type": "number", "exclusiveMinimum": 0 },
        "totalPriceVnd": { "type": "number", "minimum": 0 }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "items", "totalAmountVnd"],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/item" } },
        "totalAmountVnd": { "type": "number", "minimum": 0 }
      }
    }
  }
}
